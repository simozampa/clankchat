{
  "description": "Keep Claude in its launch worktree and share explicit instructions and proposed plans.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/capture-shared-instruction.mjs"],
            "timeout": 5,
            "statusMessage": "Sharing explicit instruction through SameTree"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/guard-worktree.mjs"],
            "timeout": 5,
            "statusMessage": "Checking SameTree worktree boundary"
          }
        ]
      },
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/publish-plan.mjs"],
            "timeout": 5,
            "statusMessage": "Publishing proposed plan to SameTree"
          }
        ]
      }
    ]
  }
}
