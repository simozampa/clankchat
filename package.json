{
  "name": "clankerchat",
  "version": "0.1.0",
  "description": "comms for your coding agents",
  "keywords": [
    "agent",
    "agents",
    "comms",
    "claude-code",
    "codex",
    "opencode",
    "mcp",
    "mcp-server",
    "multi-agent"
  ],
  "homepage": "https://github.com/simozampa/clankerchat#readme",
  "bugs": "https://github.com/simozampa/clankerchat/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simozampa/clankerchat.git"
  },
  "license": "MIT",
  "author": "Simone Zamparini",
  "type": "module",
  "files": [
    "dist",
    "docs",
    ".claude-plugin",
    "plugins",
    "npm-shrinkwrap.json",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "README.md",
    "SECURITY.md"
  ],
  "bin": {
    "clankerchat": "dist/cli.js",
    "clankerchat-mcp": "dist/mcp.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run lint && npm run typecheck && npm test",
    "format": "biome format --write .",
    "lint": "biome check .",
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepack": "npm run build",
    "test": "npm run build && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "commander": "^15.0.0",
    "jsonc-parser": "^3.3.1",
    "smol-toml": "^1.7.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@types/node": "^22.20.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
